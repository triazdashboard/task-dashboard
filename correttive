</head>
<body><main class="shell">
<header class="header"><div class="brand"><div class="mark" aria-hidden="true">GS</div><div><div class="eyebrow">Global Services · Tenant report</div><h1>Correttive e servizi</h1></div></div><div class="actions"><div class="stamp"><div id="updated">Dati in caricamento</div><div id="filemeta" class="sub"></div><div id="stale" class="stale"></div></div><button id="refresh" class="hide-print" type="button">Aggiorna</button><button id="print" class="hide-print" type="button">Stampa / PDF</button></div></header>
<div id="loading" role="status">Caricamento del report…</div>
<section id="error" class="error" hidden role="alert"><h2>Impossibile caricare i dati</h2><p id="errortext"></p><p class="small-note">La pagina e correttive_data.json devono essere nella stessa cartella pubblicata su GitHub Pages.</p><div class="actions" style="margin-top:14px"><button type="button" id="retry">Riprova</button><label for="localfile">Oppure apri il JSON locale: <input id="localfile" type="file" accept=".json,application/json"></label></div></section>
<div id="app" hidden>
<div class="topnav"><nav aria-label="Sezioni"><a href="#overview">Panoramica</a><a href="#requests">Richieste</a><a href="#performance">Prestazioni</a><a href="#history">Storico</a><a href="#quality">Qualità dati</a></nav><div class="sub">Solo task Corrective · aggiornamento notturno</div></div>
<div class="filters"><div class="filterset"><label class="field">Sede<select id="site"><option value="">Tutte le sedi</option></select></label><label class="field">Mese di inizio previsto<select id="month"><option value="">Intero export</option></select></label><label class="field">Ambito<select id="category"><option value="">Tutti gli ambiti</option></select></label><button id="reset" type="button">Azzera filtri</button></div><p class="scope" id="scope"></p></div>
<section id="overview"><div class="kpis" id="kpis"></div><div class="recap"><strong>Il punto sul servizio</strong><span id="recap"></span></div>
<div class="grid3"><section class="panel"><div class="panel-head"><div><h2>Attività da seguire</h2><p class="sub">Stato operativo delle richieste residue</p></div></div><div id="statusRows"></div></section>
<section class="panel"><div class="panel-head"><div><h2>Servizi richiesti</h2><p class="sub">Distribuzione per ambito · numero di task</p></div></div><div id="categoryBars"></div><details><summary>Dettaglio delle classi di richiesta</summary><div id="classBars"></div></details></section>
<section class="panel"><div class="panel-head"><div><h2>Da quanto restano aperte</h2><p class="sub">Giorni dall’inizio previsto</p></div></div><div id="agingBars"></div><div class="divide"></div><div class="rowstat"><span>Richiesta residua più vecchia</span><span class="value" id="oldest"></span></div><p class="small-note">Il conteggio parte dalla Baseline Inizio. Non è disponibile la data di creazione della richiesta.</p></section></div></section>
<section id="requests"><div class="sectiontitle"><h2>Richieste e avanzamento</h2><span class="sub" id="taskcount"></span></div><div class="panel"><div class="panel-head"><div><p class="sub">Prima ritardi e bozze, poi assegnazioni mancanti e richieste più vecchie.</p></div><div class="tabletools hide-print"><label class="field">Visualizza<select id="taskstatus"><option value="open">Da risolvere</option><option value="all">Tutte</option><option value="done">Concluse</option><option value="late">Fuori SLA</option><option value="draft">Bozze</option></select></label><label class="field">Cerca<input id="search" type="search" placeholder="ID, descrizione, responsabile…"></label><button id="csv" type="button">Esporta CSV</button></div></div><div class="tablewrap"><table><thead><tr><th>ID / richiesta</th><th>Sede / ubicazione</th><th>Responsabile</th><th>Stato</th><th>SLA</th><th class="num">Giorni¹</th><th>Scadenza</th><th>Prossima azione</th></tr></thead><tbody id="taskbody"></tbody></table></div><div class="pager"><span class="sub" id="pagelabel"></span><div class="actions"><button id="prevpage" type="button">Precedenti</button><button id="nextpage" type="button">Successive</button></div></div><p class="small-note">¹ Giorni di calendario dall’inizio previsto, per le task non concluse. Seleziona una richiesta per date, descrizione e aggiornamenti.</p></div></section>
<section id="performance"><div class="sectiontitle"><h2>Prestazioni del servizio</h2><span class="sub">Valori riferiti alle task selezionate</span></div>
<div class="grid2"><section class="panel"><div class="panel-head"><div><h2>Rispetto dei termini</h2><p class="sub">Completed e Closed considerate entrambe concluse</p></div></div><div id="slaRows"></div><div class="divide"></div><h3>Interventi conclusi in ritardo</h3><div id="lateList"></div></section>
<section class="panel"><div class="panel-head"><div><h2>Tempi registrati</h2><p class="sub">Ore di calendario · mediana delle richieste concluse</p></div></div><div class="twostats"><div><p class="sub">Da inizio effettivo a fine</p><div class="mini-number" id="medianActual"></div><p class="sub" id="medianN"></p></div><div><p class="sub">Da inizio previsto a fine</p><div class="mini-number" id="medianBaseline"></div><p class="sub">Riferimento: Baseline Inizio</p></div></div><p class="small-note">Sono intervalli tra date registrate, comprensivi di attese e ore non lavorative. Non sono ore di manodopera né tempi certificati di presa in carico.</p><div class="divide"></div><h3>Priorità delle richieste</h3><div id="priorityRows"></div></section></div>
<div class="grid2"><section class="panel"><div class="panel-head"><h2>Situazione per sede</h2></div><div class="tablewrap"><table><thead><tr><th>Sede</th><th class="num">Totali</th><th class="num">Concluse</th><th class="num">Residue</th><th class="num">Attive scadute</th><th class="num">SLA concluse</th></tr></thead><tbody id="sitebody"></tbody></table></div></section>
<section class="panel"><div class="panel-head"><h2>Organizzazioni responsabili</h2></div><div class="tablewrap"><table><thead><tr><th>Organizzazione</th><th class="num">Concluse / totali</th><th class="num">Residue</th><th class="num">SLA concluse</th></tr></thead><tbody id="orgbody"></tbody></table></div><p class="small-note">Il confronto va letto insieme a categoria, scadenze e numerosità. Le organizzazioni gestiscono attività diverse.</p></section></div></section>
<section id="history"><div class="sectiontitle"><h2>Andamento nel tempo</h2></div><div class="grid2"><section class="panel"><div class="panel-head"><div><h2>Richieste concluse per settimana</h2><p class="sub">Data di fine effettiva · task presenti nell’export selezionato</p></div></div><div id="completionChart"></div></section><section class="panel"><div class="panel-head"><div><h2>Richieste residue negli export</h2><p class="sub" id="historyScope"></p></div></div><div id="historyChart"></div><p class="history-note">Una fotografia per giorno. Il perimetro dell’export può cambiare: una diminuzione non equivale necessariamente a richieste risolte.</p></section></div>
<div class="panel"><div class="panel-head"><div><h2>Cambiamenti dall’export precedente</h2><p class="sub" id="changeScope"></p></div></div><div id="changeCards" class="changes"></div><details><summary>Vedi ID e cambiamenti osservati</summary><div id="changeDetail"></div></details><div id="missingOpen"></div></div></section>
<section id="quality"><div class="sectiontitle"><h2>Completezza e lettura dei dati</h2></div><div class="panel"><div class="quality" id="qualityCards"></div><details><summary>Segnalazioni e anomalie</summary><div id="issues"></div></details><details><summary>Come leggere questo report</summary><ul><li>Il report comprende solo le task con Tipo Task = Corrective presenti nell’export. Comprende servizi su richiesta, non soltanto guasti.</li><li>Il filtro mese usa Baseline Inizio, non la data di creazione. L’export può includere più mesi e non documenta il proprio criterio di selezione.</li><li>Concluse = Completed + Closed. Residue = tutti gli altri stati, incluse le bozze.</li><li>SLA = concluse In Time / concluse con SLA In Time o Late. I valori mancanti restano non disponibili e non diventano 100%.</li><li>SLA e ritardi sono riferiti all’orario dell’estrazione. La pagina non ricalcola lo stato delle task come se fosse collegata in tempo reale a TRIRIGA.</li><li>Lo storico conserva le fotografie giornaliere dell’intero export; i filtri mese e ambito non si applicano allo storico. La sede invece sì.</li><li>Le nuove osservazioni indicano ID assenti nell’export precedente, non necessariamente richieste appena create. Le task scomparse non vengono considerate automaticamente concluse.</li><li>L’ultimo cambiamento osservato viene rilevato confrontando due export. Non equivale all’ultimo intervento del tecnico.</li><li>Prossima azione e aggiornamento del gestore sono annotazioni opzionali. Se mancano, il report li indica come non disponibili.</li></ul></details></div></section>
<footer class="footer"><span id="sourceFooter"></span><span>TRIRIGA · Global Services · recap tenant</span></footer>
</div>
</main><dialog id="taskdialog"><div class="dialogtop"><div><p class="eyebrow" id="detailId"></p><h2 id="detailTitle"></h2></div><button type="button" id="closeDialog" aria-label="Chiudi dettaglio">Chiudi</button></div><div id="detailContent"></div></dialog>
<script>
function summarize(tasks) {
  const done = tasks.filter(t => ['Completed','Closed'].includes(t.status));
  const active = tasks.filter(t => t.status === 'Active');
  const draft = tasks.filter(t => t.status === 'Draft');
  const open = tasks.filter(t => !['Completed','Closed'].includes(t.status));
  const onTime = done.filter(t => t.sla_state === 'in_time').length;
  const lateDone = done.filter(t => t.sla_state === 'late').length;
  const valid = onTime + lateDone;
  const median = values => { const a=values.filter(v=>Number.isFinite(v)&&v>=0).sort((a,b)=>a-b); return a.length ? Math.round((a[Math.floor(a.length/2)]+a[Math.ceil(a.length/2)-1])/2*10)/10 : null; };
  return {
    total:tasks.length, completed:tasks.filter(t=>t.status==='Completed').length, closed:tasks.filter(t=>t.status==='Closed').length,
    done:done.length, active:active.length, draft:draft.length, unresolved:open.length,
    unknown_status:tasks.filter(t=>!['Completed','Closed','Active','Draft'].includes(t.status)).length,
    done_on_time:onTime, done_late:lateDone, done_sla_unknown:done.length-valid,
    sla_pct:valid?Math.round(onTime/valid*1000)/10:null,
    completion_pct:tasks.length?Math.round(done.length/tasks.length*1000)/10:null,
    active_late:active.filter(t=>t.sla_state==='late').length,
    active_on_time:active.filter(t=>t.sla_state==='in_time').length,
    active_sla_unknown:active.filter(t=>!['late','in_time'].includes(t.sla_state)).length,
    on_site:active.filter(t=>t.assignment==='On Site').length,
    accepted:active.filter(t=>t.assignment==='Accepted').length,
    unassigned:active.filter(t=>t.assignment==='Unassigned').length,
    other_assignment:active.filter(t=>!['On Site','Accepted','Unassigned'].includes(t.assignment)).length,
    due_today:active.filter(t=>t.due_in_days===0).length,
    due_7d:active.filter(t=>t.due_in_days!==null&&t.due_in_days>=0&&t.due_in_days<=7).length,
    oldest_days:open.reduce((m,t)=>t.age_days===null?m:Math.max(m??0,t.age_days),null),
    median_execution_hours:median(done.map(t=>t.execution_hours)),
    median_from_baseline_hours:median(done.map(t=>t.from_baseline_hours)),
    median_execution_n:done.filter(t=>t.execution_hours!==null&&t.execution_hours>=0).length,
    missing_building:tasks.filter(t=>!t.building).length, missing_priority:tasks.filter(t=>!t.priority).length,
    missing_organization:tasks.filter(t=>!t.organization).length, missing_description:tasks.filter(t=>!t.description).length,
    missing_planned_end:tasks.filter(t=>!t.planned_end).length,
    done_missing_end:done.filter(t=>!t.actual_end).length,
    date_anomalies:tasks.filter(t=>t.issues.length>0).length,
    aging:[{label:'0–7 giorni',value:open.filter(t=>t.age_days!==null&&t.age_days<=7).length},
      {label:'8–14 giorni',value:open.filter(t=>t.age_days>7&&t.age_days<=14).length},
      {label:'15–30 giorni',value:open.filter(t=>t.age_days>14&&t.age_days<=30).length},
      {label:'Oltre 30 giorni',value:open.filter(t=>t.age_days>30).length},

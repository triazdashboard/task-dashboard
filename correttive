function drawChart(id,items,type,label){
 const target=el(id);if(!items.length){target.innerHTML='<div class="empty">Dati non disponibili.</div>';return;}
 if(type==='line'&&items.length<2){target.innerHTML=`<div class="empty"><div><div class="accent-figure">${n(items[0].value)}</div><p>Residue al ${dt(items[0].date)}</p><p class="small-note">Il trend comparirà dalla seconda estrazione giornaliera.</p></div></div>`;return;}
 const W=Math.max(250,target.clientWidth),H=205,L=35,R=14,T=18,B=34,max=Math.max(1,...items.map(d=>d.value));
 const start=Date.parse(items[0].date+'T00:00:00Z'),end=Date.parse(items.at(-1).date+'T00:00:00Z');
 const bw=(W-L-R)/items.length;
 const x=(d,i)=>type==='bar'?L+bw*(i+.5):L+(end===start?.5:(Date.parse(d.date+'T00:00:00Z')-start)/(end-start))*(W-L-R);
 const y=v=>H-B-v/max*(H-T-B);
 let body='';
 for(let i=0;i<=4;i++){const val=max*i/4,yy=y(val);body+=`<line x1="${L}" y1="${yy}" x2="${W-R}" y2="${yy}" stroke="#e7edf3"/><text x="${L-7}" y="${yy+3}" text-anchor="end">${n(val)}</text>`;}
 if(type==='bar')body+=items.map((d,i)=>`<rect x="${x(d,i)-Math.max(2,bw*.6)/2}" y="${y(d.value)}" width="${Math.max(2,bw*.6)}" height="${H-B-y(d.value)}" rx="2" fill="#4b79a8"><title>Settimana dal ${dt(d.date)}: ${d.value} concluse</title></rect>${items.length<=12?`<text x="${x(d,i)}" y="${y(d.value)-5}" text-anchor="middle">${d.value}</text>`:''}`).join('');
 else{body+=`<path d="${items.map((d,i)=>(i?'L':'M')+x(d,i)+','+y(d.value)).join(' ')}" fill="none" stroke="#4b79a8" stroke-width="2.5"/>`;body+=items.map((d,i)=>`<circle cx="${x(d,i)}" cy="${y(d.value)}" r="3" fill="#4b79a8"><title>${dt(d.date)}: ${d.value} residue</title></circle>`).join('');}

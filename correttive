 target.innerHTML=`<svg class="chart" viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(label)}"><title>${esc(label)}</title><desc>${esc(items.map(d=>dt(d.date)+': '+d.value).join('; '))}</desc>${body}</svg>`;
}

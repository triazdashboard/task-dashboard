window.addEventListener('beforeprint',()=>{if(data){printing=true;renderTasks();}});window.addEventListener('afterprint',()=>{if(data){printing=false;renderTasks();}});
el('closeDialog').onclick=()=>el('taskdialog').close();
document.addEventListener('click',e=>{const b=e.target.closest('[data-task]');if(b)detail(b.dataset.task);});
el('localfile').onchange=async e=>{try{const f=e.target.files[0];if(f)init(JSON.parse(await f.text()));}catch(err){el('errortext').textContent=err.message;}};
let resizeTimer;window.addEventListener('resize',()=>{clearTimeout(resizeTimer);resizeTimer=setTimeout(()=>{if(data)renderTrends();},150);});
setInterval(()=>{if(!document.hidden&&location.protocol!=='file:'&&!el('taskdialog').open)load();},300000);
load();
</script></body></html>

@media print{@page{size:A4 landscape;margin:9mm}body{background:white;font-size:10px}.shell{padding:0;max-width:none}.hide-print,.topnav,.filters,.tabletools,.pager,dialog{display:none!important}.header{margin-bottom:14px}.panel,.kpi{box-shadow:none;break-inside:avoid}.kpis{grid-template-columns:repeat(6,1fr)}.grid3{grid-template-columns:1fr 1.25fr 1fr}.grid3>.panel:last-child{grid-column:auto}.grid2{grid-template-columns:1fr 1fr}.panel{padding:12px}.chart{height:170px}.tablewrap{overflow:visible}th,td{padding:6px}.footer{margin-top:10px}*{-webkit-print-color-adjust:exact;print-color-adjust:exact}}

*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:20px}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,select{font:inherit}button,select,summary{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible,a:focus-visible{outline:3px solid #6090bf;outline-offset:3px}a{color:var(--blue)}h1,h2,h3,p{margin:0}h1{font-size:27px;letter-spacing:-.8px;font-weight:650}h2{font-size:17px;letter-spacing:-.25px;font-weight:650}h3{font-size:14px;font-weight:600}button{border:1px solid var(--line);border-radius:7px;background:var(--panel);color:var(--ink);padding:9px 13px}button:hover{background:var(--lightblue)}button.primary{background:var(--navy);border-color:var(--navy);color:#fff}button:disabled{opacity:.45;cursor:default}button.text{border:0;background:transparent;padding:0;text-align:left;color:var(--blue)}.shell{max-width:1800px;margin:0 auto;padding:26px 32px 40px}.header{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:23px}.brand{display:flex;gap:14px;align-items:center}.mark{height:44px;width:44px;background:var(--navy);color:#fff;display:grid;place-items:center;border-radius:11px;font-weight:650;letter-spacing:-1px}.eyebrow{color:var(--muted);font-size:11px;font-weight:650;letter-spacing:1.35px;text-transform:uppercase}.sub{font-size:12px;color:var(--muted)}.stamp{text-align:right}.actions{display:flex;gap:8px;align-items:center}.topnav{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);margin-bottom:20px;gap:14px;flex-wrap:wrap}.topnav nav{display:flex;gap:25px;flex-wrap:wrap}.topnav a{padding:0 0 11px;text-decoration:none;font-size:13px;color:var(--muted)}.topnav a:first-child{color:var(--navy);border-bottom:2px solid var(--navy)}.topnav .sub{padding-bottom:11px}.filters{display:flex;justify-content:space-between;gap:16px;align-items:end;margin-bottom:20px;flex-wrap:wrap}.filterset{display:flex;gap:10px;flex-wrap:wrap;align-items:end}label.field{display:flex;flex-direction:column;gap:5px;font-size:11px;font-weight:600;color:var(--muted)}select,input[type=search]{padding:9px 11px;border:1px solid var(--line);border-radius:7px;background:#fff;color:var(--ink);min-width:155px;max-width:100%}.scope{font-size:12px;color:var(--muted);max-width:570px}.kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px;margin-bottom:17px}.kpi{padding:17px 18px;background:var(--panel);border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow)}.kpi-label{font-size:12px;font-weight:550;color:var(--muted)}.kpi-value{font-size:31px;letter-spacing:-1px;font-weight:650;line-height:1.25;margin:9px 0 7px;font-variant-numeric:tabular-nums}.kpi-foot{font-size:11px;color:var(--muted)}.kpi.emphasis{border-top:3px solid var(--navy);padding-top:15px}.recap{padding:13px 17px;background:var(--lightblue);border-radius:8px;font-size:13px;margin-bottom:20px;display:flex;align-items:start;gap:14px}.recap strong{font-weight:650;white-space:nowrap}.grid3{display:grid;grid-template-columns:1fr 1.25fr 1fr;gap:17px;margin-bottom:18px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:17px;margin-bottom:18px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:20px;box-shadow:var(--shadow);min-width:0}.panel-head{display:flex;justify-content:space-between;gap:15px;align-items:start;margin-bottom:17px;flex-wrap:wrap}.panel-head .sub{margin-top:4px}.rowstat{display:flex;justify-content:space-between;gap:10px;padding:8px 0;font-size:13px}.rowstat .value{font-variant-numeric:tabular-nums;font-weight:600}.rowstat+.rowstat{border-top:1px solid #f0f3f6}.dot{width:8px;height:8px;display:inline-block;border-radius:50%;margin-right:8px;background:var(--blue)}.dot.amber{background:var(--amber)}.dot.green{background:var(--green)}.dot.red{background:var(--red)}.dot.gray{background:#9aa6b5}.barrow{margin-bottom:12px}.barline{display:flex;justify-content:space-between;gap:12px;font-size:12px;margin-bottom:5px}.track{height:7px;background:#f0f3f7;border-radius:2px;overflow:hidden}.barfill{height:100%;background:var(--blue);border-radius:2px}.barfill.amber{background:#c29659}.barfill.green{background:var(--green)}.barfill.red{background:var(--red)}.badge{display:inline-block;white-space:nowrap;font-size:11px;padding:3px 7px;border-radius:4px;background:#f0f3f7;color:#586b7e}.badge.green{background:var(--lightgreen);color:var(--green)}.badge.red{background:var(--lightred);color:var(--red)}.badge.amber{background:var(--lightamber);color:var(--amber)}.badge.blue{background:var(--lightblue);color:var(--blue)}.sectiontitle{display:flex;align-items:baseline;justify-content:space-between;gap:20px;margin:25px 0 13px}.tablewrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:12px}th{text-align:left;font-size:10px;letter-spacing:.4px;text-transform:uppercase;color:var(--muted);font-weight:600;background:#f8fafc;padding:11px 10px;border-bottom:1px solid var(--line);white-space:nowrap}td{padding:12px 10px;border-bottom:1px solid #eef1f5;vertical-align:top}tbody tr:last-child td{border-bottom:0}tbody tr:hover{background:#fafbfd}.num{text-align:right;font-variant-numeric:tabular-nums}.namecell{max-width:380px;min-width:220px}.tasktitle{display:block;color:var(--ink);font-weight:550;white-space:normal;line-height:1.5}.taskmeta{color:var(--muted);font-size:10px;margin-top:4px}.small-note{font-size:11px;color:var(--muted);margin-top:13px}.tabletools{display:flex;gap:9px;flex-wrap:wrap;align-items:end}.tabletools input{min-width:230px}.tabletools label select{min-width:130px}.pager{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-top:14px}.pager .actions button{padding:5px 11px}.empty{min-height:190px;display:flex;align-items:center;justify-content:center;text-align:center;color:var(--muted);font-size:13px;padding:25px}.empty.compact{min-height:70px}.chart{height:205px;width:100%;display:block}.chart text{font-family:inherit;fill:var(--muted);font-size:10px}.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin-top:8px}.history-note{font-size:11px;color:var(--muted);margin-top:10px}.twostats{display:grid;grid-template-columns:1fr 1fr;gap:16px}.mini-number{font-size:24px;font-weight:600;margin:7px 0}.divide{border-top:1px solid var(--line);margin:15px 0}.quality{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.quality-item{padding:12px;background:#f8fafc;border-radius:6px}.quality-item b{display:block;font-size:20px;font-weight:600;margin-top:5px}.changes{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.changes .mini-number{font-size:23px}.footer{display:flex;justify-content:space-between;gap:15px;margin-top:22px;flex-wrap:wrap;font-size:11px;color:var(--muted)}details summary{font-size:12px;color:var(--blue);padding:7px 0}details p,details li{font-size:12px;color:var(--muted)}details ul{padding-left:20px;margin-bottom:0}.error{background:var(--lightred);border:1px solid #e9c8c4;color:#7f352d;border-radius:10px;padding:22px}.error h2{margin-bottom:8px}#loading{padding:80px;text-align:center;color:var(--muted)}#app[hidden],#error[hidden],#loading[hidden]{display:none}.stale{color:var(--amber);font-size:11px;margin-top:3px}dialog{border:1px solid var(--line);border-radius:12px;padding:25px;max-width:800px;width:calc(100% - 32px);color:var(--ink);box-shadow:0 15px 60px #16283c30}dialog::backdrop{background:#17283c60}dialog .dialogtop{display:flex;justify-content:space-between;gap:15px;margin-bottom:20px}.detailgrid{display:grid;grid-template-columns:1fr 1fr;gap:17px;font-size:13px}.detailgrid dt{color:var(--muted);font-size:11px;margin-bottom:3px}.detailgrid dd{margin:0;overflow-wrap:anywhere}.detailtext{white-space:pre-wrap;font-size:13px;overflow-wrap:anywhere}.clickable{cursor:pointer}.hide-print{display:initial}.scope-note{font-size:11px;color:var(--muted);padding:8px 0}.accent-figure{font-size:32px;font-weight:650;color:var(--navy)}
@media(min-width:1550px){.shell{padding-left:42px;padding-right:42px}.panel{padding:23px}.chart{height:220px}.kpi-value{font-size:35px}}
